{
  "manifest_version": 2,
  "name": "Mail Tracker for Firefox",
  "version": "1.1.0",
  "description": "Track when your emails are opened by recipients with read receipts and detailed analytics.",

  "icons": {
    "48": "icons/icon.png",
    "96": "icons/icon.png"
  },

  "browser_action": {
    "default_icon": "icons/icon.png",
    "default_title": "Mail Tracker",
    "default_popup": "popup/popup.html"
  },

  "permissions": [
    "storage",
    "tabs",
    "webRequest",
    "webRequestBlocking",
    "*://mail.google.com/*",
    "http://localhost:5000/*",
    "http://127.0.0.1:5000/*"
  ],

  "content_scripts": [
    {
      "matches": ["*://mail.google.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],

  "background": {
    "scripts": ["background.js"],
    "persistent": true
  },

  "browser_specific_settings": {
    "gecko": {
      "id": "mail-tracker@example.com",
      "strict_min_version": "78.0"
    }
  },

  "content_security_policy": "script-src 'self' https://cdnjs.cloudflare.com; object-src 'self'; connect-src http://localhost:5000 http://127.0.0.1:5000",
  
  "web_accessible_resources": [
    "icons/*.png"
  ]
}